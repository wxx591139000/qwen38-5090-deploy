# Qwen3.8-27B LLM Service (llama-server, RTX 5090, 512K YaRN 档)
# 放到 /etc/systemd/system/qwen38.service
# 用法: systemctl daemon-reload && systemctl enable --now qwen38
[Unit]
Description=Qwen3.8-27B LLM Service (llama-server)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/autodl-tmp
ExecStart=/root/autodl-tmp/llama.cpp/build/bin/llama-server \
  -m /root/autodl-tmp/models/Qwen3.8-27B-Q4_K_M.gguf \
  --alias qwen3.8-27b \
  -ngl 999 \
  -c 524288 \
  -fa on \
  -ctk q4_0 -ctv q4_0 \
  -b 512 -ub 128 \
  -np 1 \
  --reasoning off \
  --jinja \
  --chat-template-file /root/autodl-tmp/qwen38_template.jinja \
  --rope-scaling yarn --yarn-orig-ctx 262144 \
  --host 0.0.0.0 --port 6006 \
  --api-key-file /root/autodl-tmp/.api_keys
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
